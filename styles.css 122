*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body {
  background: #f5f5f5;
  color: #222;
}

/* HEADER / MENU + BARRE DE RECHERCHE EN HAUT */

.header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 12px 32px;
  background: #ffffff;
  border-bottom: 1px solid #e0e0e0;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.06);
}

.logo {
  font-weight: 800;
  font-size: 22px;
  color: #f7931e;
}

/* bloc central : barre de recherche */
.header-search {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 700px;
}

/* on réutilise .search-box mais dans le header */
.header-search .search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f3f4f6;
  border-radius: 999px;
  padding: 8px 14px;
  border: 1px solid #e5e7eb;
}

.header-search .search-icon {
  margin-right: 10px;
  font-size: 18px;
  color: #6b7280;
}

.header-search #search-input {
  border: none;
  background: transparent;
  outline: none;
  width: 100%;
  font-size: 14px;
  color: #374151;
}

/* bouton Rechercher dans le header */
.header-search .search-button {
  margin-left: 10px;
  padding: 8px 18px;
  border-radius: 999px;
}

/* NAV */
.nav {
  display: flex;
  align-items: center;
  gap: 16px;
}

.nav-link {
  text-decoration: none;
  font-size: 14px;
  color: #4b5563;
  padding: 8px 10px;
  border-radius: 999px;
  transition: background 0.2s ease, color 0.2s ease;
}

.nav-link.active,
.nav-link:hover {
  background: #fef3e7;
  color: #f7931e;
}

.cart-count {
  background: #f7931e;
  color: #fff;
  border-radius: 999px;
  padding: 0 0.45rem;
  font-size: 0.75rem;
}

/* SECTIONS GÉNÉRALES */

main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem 1rem 3rem;
}

.section {
  display: none;
}

.section.visible {
  display: block;
}

/* HERO */

.hero {
  background: linear-gradient(135deg, #ff6b35, #ff9f1c);
  color: #fff;
  border-radius: 1rem;
  padding: 3rem 2rem;
  text-align: center;
  margin-bottom: 2rem;
}

.hero h1 {
  font-size: 2rem;
  margin-bottom: 1rem;
}

.hero p {
  max-width: 600px;
  margin: 0 auto 1.5rem;
}

.btn-primary,
.btn-secondary {
  border: none;
  border-radius: 999px;
  padding: 0.6rem 1.3rem;
  font-weight: 600;
  cursor: pointer;
  font-size: 0.95rem;
}

.btn-primary {
  background: #ff6b35;
  color: #fff;
}

.btn-primary:hover {
  background: #e75a29;
}

.btn-secondary {
  background: #e0e0e0;
  color: #333;
}

.btn-secondary:hover {
  background: #d0d0d0;
}

.btn-secondary.small {
  padding: 0.4rem 0.9rem;
  font-size: 0.85rem;
}

/* ===== ENTÊTE DE LA LISTE (TITRE + FILTRES) ===== */

.page-header {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}

.page-header h2 {
  font-size: 24px;
  font-weight: 700;
  color: #374151;
}

/* filtre de recherche sous le hero (input + bouton + select) */
.search-filter {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  justify-content: flex-end;
}

/* boîte de recherche générique */
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  padding: 0 14px;
  flex: 1;
  max-width: 520px;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
}

.search-icon {
  font-size: 18px;
  color: #6b7280;
  margin-right: 8px;
}

.search-box input {
  border: none;
  outline: none;
  width: 100%;
  padding: 10px 0;
  font-size: 14px;
  color: #374151;
}

/* bouton rechercher sous le hero */
.search-button {
  white-space: nowrap;
  padding: 10px 18px;
  border-radius: 999px;
}

/* Select catégorie */
#category-filter {
  padding: 8px 10px;
  border-radius: 999px;
  border: 1px solid #d1d5db;
  background: #ffffff;
  font-size: 14px;
  color: #374151;
}

/* ===== LAYOUT LISTE + SIDEBAR ===== */

.layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 1.5rem;
}

.sidebar {
  background: #fff;
  border-radius: 0.75rem;
  padding: 1rem;
  border: 1px solid #e0e0e0;
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.sidebar h3 {
  font-size: 0.95rem;
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.sidebar select,
.sidebar input {
  width: 100%;
  padding: 0.45rem 0.6rem;
  border-radius: 0.5rem;
  border: 1px solid #ccc;
  font-size: 0.85rem;
}

.price-range {
  display: flex;
  gap: 0.5rem;
}

.checkbox {
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

/* ===== CARTES PRODUITS ===== */

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 1rem;
}

.product-card {
  background: #fff;
  border-radius: 0.75rem;
  border: 1px solid #e0e0e0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.product-image {
  width: 100%;
  height: 170px;
  object-fit: cover;
}

.product-body {
  padding: 0.75rem 0.8rem;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.product-title {
  font-size: 0.95rem;
  font-weight: 600;
}

.product-location {
  font-size: 0.8rem;
  color: #777;
}

.product-price {
  font-weight: 700;
  color: #ff6b35;
  font-size: 0.95rem;
}

.product-badges {
  display: flex;
  gap: 0.35rem;
  flex-wrap: wrap;
}

/* ===== BANDEAU ARTICLES QUI TOURNENT ===== */

.featured-strip {
  margin: 10px 0 20px;
  overflow: hidden;
  border-radius: 10px;
  background: #fff;
  border: 1px solid #e5e7eb;
}

.featured-track {
  display: flex;
  gap: 24px;
  padding: 10px 16px;
  animation: featured-scroll 25s linear infinite;
}

.featured-item {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 220px;
}

.featured-item img {
  width: 90px;
  height: 60px;
  object-fit: cover;
  border-radius: 8px;
}

.featured-title {
  font-size: 14px;
  font-weight: 600;
}

.featured-price {
  font-size: 13px;
  color: #f7931e;
  font-weight: 700;
}

/* Animation défilement horizontal */
@keyframes featured-scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

/* ===== RESPONSIVE ===== */

@media (max-width: 768px) {
  .header {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .header-search {
    width: 100%;
  }

  .nav {
    justify-content: center;
  }

  .layout {
    grid-template-columns: 1fr;
  }
}
